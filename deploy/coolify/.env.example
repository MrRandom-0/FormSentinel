# ============================================================
# FormSentinel - Coolify Environment Variables
# ============================================================
# Copy this file or paste these values into Coolify's
# "Environment Variables" panel for your service.
#
# IMPORTANT: Generate unique random secrets for each field
# marked as "required". Never reuse secrets across fields.
# In Coolify, mark sensitive values as "Secret" so they
# are not exposed in logs or the UI.
# ============================================================

# --- PostgreSQL (managed by this compose stack) ---
POSTGRES_DB=formsentinel
POSTGRES_USER=formsentinel
POSTGRES_PASSWORD=   # REQUIRED - generate a strong random password

# --- Core application secrets (all required, all unique) ---
SESSION_SECRET=              # min 32 random characters
SOURCE_HASH_SECRET=          # min 32 random characters
SERVICE_TOKEN=               # min 32 random characters
MCP_TOKEN_HASH_SECRET=       # min 32 random characters
LOCAL_ENCRYPTION_KEY=        # min 32 random characters
API_KEY_HASH_SECRET=         # min 32 random characters

# --- Public URLs ---
# Set these to your actual domain(s) configured in Coolify.
NEXT_PUBLIC_APP_URL=https://forms.example.com
NEXT_PUBLIC_INGEST_URL=https://ingest.example.com
TRUSTED_HOSTS=forms.example.com

# --- Adapter configuration ---
FORMSENTINEL_DATA_ADAPTER=postgres
FORMSENTINEL_AUTH_ADAPTER=postgres

# --- Proxy / Network ---
# Set to 1 if Coolify's Traefik proxy sits in front of the app
TRUSTED_PROXY_HOPS=1

# --- Ingest tuning ---
INGEST_MAX_BODY_BYTES=12582912

# --- Worker tuning ---
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=30000
WORKER_POLL_MS=1000

# --- Release tracking ---
# Coolify can inject the commit SHA automatically via its built-in variables.
# Use ${SOURCE_COMMIT} in Coolify's variable interpolation, or set manually.
RELEASE_SHA=

# ============================================================
# OPTIONAL INTEGRATIONS
# Leave blank to disable. The application gracefully degrades
# when these are not configured.
# ============================================================

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SECRET_KEY=

# Stripe billing
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
BILLING_RETURN_ORIGINS=https://forms.example.com

# Observability
SENTRY_DSN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=FormSentinel <noreply@forms.example.com>
EMAIL_FROM_ADDRESS=noreply@forms.example.com

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Operator IdP (SSO for admin panel)
OPERATOR_IDP_ISSUER=
OPERATOR_IDP_CLIENT_ID=
OPERATOR_MFA_REQUIRED=false

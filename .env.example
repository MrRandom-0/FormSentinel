# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INGEST_URL=http://localhost:3001
INGEST_PORT=3001
WORKER_PORT=3002
SCANNER_PORT=3003
MCP_PORT=3004

# Canonical data and private file storage. Local is development/test only.
FORMSENTINEL_DATA_ADAPTER=local
FORMSENTINEL_AUTH_ADAPTER=local
FORMSENTINEL_LOCAL_DATA_FILE=.formsentinel/dev-data.json
FORMSENTINEL_LOCAL_STORAGE_DIR=.formsentinel/files
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formsentinel
SESSION_SECRET=replace-with-at-least-32-random-characters
SOURCE_HASH_SECRET=replace-with-at-least-32-random-characters
SERVICE_TOKEN=replace-with-at-least-32-random-characters
# MCP/user tokens are independently generated, hashed, scoped, expiring, and never reuse SERVICE_TOKEN.
MCP_TOKEN_HASH_SECRET=replace-with-an-independent-32-character-secret
LOCAL_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret

# Ingest and worker controls
TRUSTED_PROXY_HOPS=0
INGEST_MAX_BODY_BYTES=12582912
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=30000
WORKER_POLL_MS=1000

# Optional CAPTCHA. Development test tokens are forbidden in production.
TURNSTILE_SECRET_KEY=

# Stripe billing. Incomplete/mode-mismatched configuration is unavailable.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
BILLING_RETURN_ORIGINS=http://localhost:3000

# Production host/operator/observability controls
TRUSTED_HOSTS=localhost:3000
API_KEY_HASH_SECRET=replace-with-an-independent-32-character-secret
OPERATOR_IDP_ISSUER=
OPERATOR_IDP_CLIENT_ID=
OPERATOR_MFA_REQUIRED=false
SENTRY_DSN=

# Reserved external providers. Missing adapters remain explicitly unavailable.
RESEND_API_KEY=
EMAIL_FROM=FormSentinel <noreply@example.test>
EMAIL_FROM_ADDRESS=noreply@example.test
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RELEASE_SHA=development
